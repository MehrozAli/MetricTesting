# Required
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333

# Optional: Qdrant Cloud needs an API key; a local Qdrant does not.
QDRANT_API_KEY=
QDRANT_COLLECTION=metric_definitions

# Optional: model overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Optional: load the system prompt from the first JavaScript code block on a
# Notion page. Leave both empty to use the prompt bundled in src/lib/systemPrompt.js.
NOTION_API_KEY=
NOTION_PROMPT_PAGE_ID=
